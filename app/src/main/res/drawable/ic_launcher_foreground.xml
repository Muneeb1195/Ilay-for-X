<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Scaled to 0.75x around (54, 54) on pure white background.
        Uses live Monet dynamic colors on Android 12+ (values-v31/colors.xml):
          - X: Primary (system_accent1_500 lit, system_accent1_700 shadowed)
          - Tilted Ring: Secondary (system_accent2_500 front, system_accent2_800 shaded back)
          - Atom: Tertiary (system_accent3_600 body, system_accent3_400 lit face, system_accent3_100 specular)
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.75"
        android:scaleY="0.75">

        <!-- 1. Back half of tilted orbital ring (darker shaded secondary tone, passing BEHIND the X) -->
        <group
            android:pivotX="54"
            android:pivotY="54"
            android:rotation="-27">
            <path
                android:pathData="M25.2,54 A28.8,10.8 0 0,1 82.8,54"
                android:strokeColor="@color/icon_ring_secondary_dark"
                android:strokeLineCap="round"
                android:strokeWidth="3.3" />
        </group>

        <!-- 2. Shadowed diagonal bar of X (bottom-left to top-right, darker primary shade in shadow) -->
        <path
            android:pathData="M34.0,74.0 L74.0,34.0"
            android:strokeColor="@color/icon_x_primary_dark"
            android:strokeLineCap="round"
            android:strokeWidth="9.4" />

        <!-- 3. Neutral cast shadow on the darker X bar where the lighter front X bar crosses over -->
        <path
            android:fillColor="#40000000"
            android:pathData="M47.35,54.00 L54.00,60.65 L52.10,62.55 L45.45,55.90 Z" />
        <path
            android:fillColor="#1F000000"
            android:pathData="M54.00,47.35 L60.65,54.00 L61.85,52.80 L55.20,46.15 Z" />

        <!-- 4. Lit diagonal bar of X (top-left to bottom-right, lighter primary color in front) -->
        <path
            android:pathData="M34.0,34.0 L74.0,74.0"
            android:strokeColor="@color/icon_x_primary_light"
            android:strokeLineCap="round"
            android:strokeWidth="9.4" />

        <!-- 5. Front half of tilted orbital ring (lighter secondary tone, passing IN FRONT of the X) -->
        <group
            android:pivotX="54"
            android:pivotY="54"
            android:rotation="-27">
            <!-- Soft neutral drop shadow cast by front ring across the X bars -->
            <path
                android:pathData="M31.94,62.24 A28.8,10.8 0 0,0 76.06,62.24"
                android:strokeColor="#2E000000"
                android:strokeLineCap="round"
                android:strokeWidth="4.4" />

            <!-- Bright lit front orbital arc -->
            <path
                android:pathData="M25.2,54 A28.8,10.8 0 0,0 82.8,54"
                android:strokeColor="@color/icon_ring_secondary_light"
                android:strokeLineCap="round"
                android:strokeWidth="4.0" />
        </group>

        <!-- 6. Orbiting atom sphere (tertiary Monet accent) positioned on the front-right of the tilted ring -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M76.35,45.22 A5.5,5.5 0 1,0 76.35,56.22 A5.5,5.5 0 1,0 76.35,45.22 Z" />
        <path
            android:fillColor="@color/icon_atom_tertiary_body"
            android:pathData="M76.35,46.42 A4.3,4.3 0 1,0 76.35,55.02 A4.3,4.3 0 1,0 76.35,46.42 Z" />
        <path
            android:fillColor="@color/icon_atom_tertiary_light"
            android:pathData="M75.75,47.02 A3.2,3.2 0 1,0 75.75,53.42 A3.2,3.2 0 1,0 75.75,47.02 Z" />
        <path
            android:fillColor="@color/icon_atom_tertiary_highlight"
            android:pathData="M74.85,47.82 A1.25,1.25 0 1,0 74.85,50.32 A1.25,1.25 0 1,0 74.85,47.82 Z" />
    </group>
</vector>
